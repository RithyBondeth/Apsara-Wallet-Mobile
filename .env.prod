APP_NAME=Apsara Wallet
# Production API custom domain (Railway). Must be https and must keep the
# /api/v1 suffix.
API_BASE_URL=https://api-wallet.apsara.social/api/v1
DEBUG_MODE=false

# TODO(deploy): paste the Sentry project DSN (sentry.io → Project → Settings →
# Client Keys). Leaving it blank ships with crash reporting disabled — the app
# still runs, you just find out about crashes from your users instead.
SENTRY_DSN=
