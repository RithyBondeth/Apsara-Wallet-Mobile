APP_NAME=Apsara Wallet
# TODO(deploy): replace with the domain Railway generates for the API service
# (Settings → Networking → Generate Domain). See apsara-wallet-api/DEPLOYMENT.md.
# Must be https and must keep the /api/v1 suffix.
API_BASE_URL=https://apsara-wallet-api-staging.up.railway.app/api/v1
DEBUG_MODE=false

# TODO(deploy): paste the Sentry project DSN (sentry.io → Project → Settings →
# Client Keys). Leaving it blank ships with crash reporting disabled — the app
# still runs, you just find out about crashes from your testers instead.
SENTRY_DSN=
