APP_NAME=Apsara Wallet (Dev)
# Local NestJS backend (apsara-wallet-api), which listens on 3010 so it can
# run beside the Apsara Talent services on 3000. On an Android emulator the
# app reaches the host via 10.0.2.2 — dio_client rewrites `localhost` to that
# automatically, so this one value works for iOS sim, Android emulator and web.
API_BASE_URL=http://localhost:3010/api/v1
DEBUG_MODE=true

# Crash reporting is off locally — an empty DSN disables Sentry entirely, so
# your own debugging never spends the project's event quota.
SENTRY_DSN=